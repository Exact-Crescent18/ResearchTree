function handleExport() {
  if(!requirePlan('export','Export is a Plus feature')) return;
  exportMenuOpen=!exportMenuOpen;
  document.getElementById('export-menu').style.display=exportMenuOpen?'block':'none';
}
document.addEventListener('click',e=>{
  if(!document.getElementById('btn-export').contains(e.target)){
    document.getElementById('export-menu').style.display='none'; exportMenuOpen=false;
  }
});
function exportJSON() {
  const tree=getActiveTree(); if(!tree) return;
  const blob=new Blob([JSON.stringify(tree,null,2)],{type:'application/json'});
  downloadBlob(blob,tree.name.replace(/\s+/g,'_')+'.json');
  document.getElementById('export-menu').style.display='none';
}
function exportMarkdown() {
  const tree=getActiveTree(); if(!tree) return;
  function nodeToMd(node,depth){
    const indent='  '.repeat(depth);
    let md=`${indent}${'#'.repeat(Math.min(depth+1,6))} ${node.title}\n`;
    if(node.desc) md+=`${node.desc}\n`;
    (node.children||[]).forEach(c=>md+=nodeToMd(c,depth+1));
    return md+'\n';
  }
  const md=`# ${tree.name}\n\n${(tree.roots||[]).map(n=>nodeToMd(n,1)).join('')}`;
  const blob=new Blob([md],{type:'text/markdown'});
  downloadBlob(blob,tree.name.replace(/\s+/g,'_')+'.md');
  document.getElementById('export-menu').style.display='none';
}
function exportCSV() {
  const tree=getActiveTree(); if(!tree) return;
  const rows=[['Title','Description','Depth','Parent']];
  function walk(nodes,depth,parent){
    nodes.forEach(n=>{rows.push([`"${(n.title||'').replace(/"/g,'""')}"`,`"${(n.desc||'').replace(/"/g,'""')}"`,depth,`"${parent}"`]);walk(n.children||[],depth+1,n.title);});
  }
  walk(tree.roots||[],0,'');
  const blob=new Blob([rows.map(r=>r.join(',')).join('\n')],{type:'text/csv'});
  downloadBlob(blob,tree.name.replace(/\s+/g,'_')+'.csv');
  document.getElementById('export-menu').style.display='none';
}
function printTree() {
  document.getElementById('export-menu').style.display='none';
  window.print();
}
function downloadBlob(blob,filename){
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;a.click();URL.revokeObjectURL(a.href);
  toast('✓ Exported: '+filename);
}

