function updateDetailPanel() {
  const inner=document.getElementById('detail-inner');
  const tree=getActiveTree();
  if(!tree||!state.selectedNode){
    inner.innerHTML=`<div class="empty-state" style="min-height:300px"><div style="font-size:40px;color:var(--text3)"><i class="ti ti-info-circle"></i></div><p>Click a node's Info button to see details here.</p></div>`;
    return;
  }
  const node=findNode(tree.roots||[],state.selectedNode); if(!node) return;
  const path=getNodePath(tree.roots||[],state.selectedNode);
  const pathStr=path?path.map(n=>n.title).join(' › '):'';
  const imgs=(node.media||[]).filter(m=>m.type==='image');
  const vids=(node.media||[]).filter(m=>m.type==='video');
  const links=(node.media||[]).filter(m=>m.type==='link');

  let html=`
    <div class="detail-close">
      <span class="detail-path" title="${escHtml(pathStr)}">${escHtml(pathStr.length>50?pathStr.slice(0,50)+'…':pathStr)}</span>
      <button class="icon-btn" onclick="closeDetail()"><i class="ti ti-x"></i></button>
    </div>
    <h2 class="detail-title">${escHtml(node.title)}</h2>
    ${node.desc?`<p class="detail-desc">${escHtml(node.desc)}</p>`:''}
    ${node.note&&can('nodeNotes')?`<div class="detail-section"><div class="detail-section-title"><i class="ti ti-notebook"></i> Notes</div><div class="node-note" style="margin:0">${escHtml(node.note)}</div></div>`:''}
    <div style="display:flex;gap:6px;margin-bottom:20px">
      <button class="node-btn btn-edit-node" onclick="openNodeModal({editId:'${node.id}',treeId:'${tree.id}'},null)"><i class="ti ti-pencil"></i> Edit</button>
      <button class="node-btn btn-child" onclick="handleAddNode({parentId:'${node.id}',treeId:'${tree.id}'},null)"><i class="ti ti-plus"></i> Add child</button>
    </div>`;

  if(imgs.length&&can('media')){
    html+=`<div class="detail-section"><div class="detail-section-title"><i class="ti ti-photo"></i> Images (${imgs.length})</div>`;
    imgs.forEach(m=>{html+=`<div class="detail-media-item"><img class="detail-media-img" src="${escHtml(m.url)}" alt="${escHtml(m.name||'')}" onerror="this.style.display='none'">${m.name?`<div class="detail-media-caption">${escHtml(m.name)}</div>`:''}</div>`;});
    html+='</div>';
  }
  if(vids.length&&can('media')){
    html+=`<div class="detail-section"><div class="detail-section-title"><i class="ti ti-video"></i> Videos (${vids.length})</div>`;
    vids.forEach(m=>{
      let eu=m.url;
      const yt=m.url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s?]+)/);
      const vi=m.url.match(/vimeo\.com\/(\d+)/);
      if(yt) eu=`https://www.youtube.com/embed/${yt[1]}`;
      else if(vi) eu=`https://player.vimeo.com/video/${vi[1]}`;
      html+=`<div class="detail-media-item"><div class="detail-video-wrap"><iframe src="${escHtml(eu)}" allowfullscreen loading="lazy"></iframe></div>${m.name?`<div class="detail-media-caption">${escHtml(m.name)}</div>`:''}</div>`;
    });
    html+='</div>';
  }
  if(links.length){
    html+=`<div class="detail-section"><div class="detail-section-title"><i class="ti ti-link"></i> Links (${links.length})</div>`;
    links.forEach(m=>{html+=`<a class="detail-link" href="${escHtml(m.url)}" target="_blank" rel="noopener"><i class="ti ti-external-link" style="flex-shrink:0;font-size:15px"></i><div style="flex:1;min-width:0"><div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:var(--text)">${escHtml(m.name||m.url)}</div><div style="font-size:11px;color:var(--text3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(m.url)}</div></div></a>`;});
