          <div class="plan-name" style="color:var(--gold)">Pro</div>
          <span style="font-size:10px;font-weight:600;background:linear-gradient(135deg,#d4a843,#b8892e);color:#1a1200;padding:2px 8px;border-radius:20px">BEST VALUE</span>
        </div>
        <div class="plan-price" style="color:var(--gold)">$19<span>/mo</span></div>
        <div class="plan-tagline">For power users building deep knowledge systems.</div>
        <ul class="plan-features">
          <li><i class="ti ti-check feat-gold"></i>Everything in Plus</li>
          <li><i class="ti ti-check feat-gold"></i>Node color labels</li>
          <li><i class="ti ti-check feat-gold"></i>Node tags & filtering</li>
          <li><i class="ti ti-check feat-gold"></i>Inline node notes (rich text)</li>
          <li><i class="ti ti-check feat-gold"></i>Tree statistics dashboard</li>
          <li><i class="ti ti-check feat-gold"></i>AI-powered node suggestions</li>
          <li><i class="ti ti-check feat-gold"></i>Multiple collaborators</li>
          <li><i class="ti ti-check feat-gold"></i>Custom node templates</li>
        </ul>
        <button class="btn-gold" style="width:100%;justify-content:center" onclick="activatePlan('pro')">
          <i class="ti ti-crown"></i> Go Pro
        </button>
      </div>
    </div>
    <div class="paywall-footer">
      <button class="btn-secondary" onclick="closePaywall()">Maybe later — stay on Free</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
const EMOJIS=['📚','🔬','🎮','🏛️','🌍','⚡','🧬','🎨','🎵','🚀','💡','🏺','🧪','📡','🌿','🔭','⚔️','🎭','🏗️','🌊','🧠','💻','🎬','📰','🔮','🎯','🦠','🌐','🏆','🎪','🦋','🌋','🔑','💎','🌸','🐉'];
const TREE_COLORS=['#7c6af0','#3dbfa0','#e8715a','#d4a843','#5bc8f5','#e07bb0','#6fd98f','#f0a653'];
const NODE_COLORS=['none','teal','coral','gold','purple','blue'];

// ===== PLAN LIMITS =====
const PLANS = {
  free:  { trees: 3, nodes: 20, media: false, export: false, nodeSearch: false, nodeColors: false, nodeTags: false, nodeNotes: false, stats: false, aiSuggest: false },
  plus:  { trees: Infinity, nodes: Infinity, media: true, export: true, nodeSearch: true, nodeColors: false, nodeTags: false, nodeNotes: false, stats: false, aiSuggest: false },
  pro:   { trees: Infinity, nodes: Infinity, media: true, export: true, nodeSearch: true, nodeColors: true, nodeTags: true, nodeNotes: true, stats: true, aiSuggest: true }
};

// ===== STATE =====
let state = {
  plan: 'free',
  trees: [], activeTree: null, collapsed: {}, selectedNode: null, detailOpen: false, sidebarOpen: true
};
let _mediaItems = [];
let exportMenuOpen = false;

function plan() { return PLANS[state.plan] || PLANS.free; }
function can(feature) { return plan()[feature]; }

// ===== PERSISTENCE =====
function save() { try { localStorage.setItem('rt_v3', JSON.stringify(state)); } catch(e){} }
function load() { try { const d=localStorage.getItem('rt_v3'); if(d) state={...state,...JSON.parse(d)}; } catch(e){} }

// ===== UTILS =====
function uid() { return Date.now().toString(36)+Math.random().toString(36).slice(2,6); }
function toast(msg,dur=2200) {
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),dur);
}
function getActiveTree() { return state.trees.find(t=>t.id===state.activeTree); }
function findNode(nodes,id) {
  for(const n of nodes){ if(n.id===id) return n; const r=findNode(n.children||[],id); if(r) return r; } return null;
}
function countNodes(nodes) { return nodes.reduce((s,n)=>s+1+countNodes(n.children||[]),0); }
function deleteNodeFrom(nodes,id) {
  const i=nodes.findIndex(n=>n.id===id); if(i>-1){nodes.splice(i,1);return true;}
  return nodes.some(n=>deleteNodeFrom(n.children||[],id));
}
function getNodePath(roots,id,path=[]) {
  for(const n of roots){ const p=[...path,n]; if(n.id===id) return p; const r=getNodePath(n.children||[],id,p); if(r) return r; } return null;
}
function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function totalNodes() { const t=getActiveTree(); return t ? countNodes(t.roots||[]) : 0; }
function allNodes(nodes,arr=[]) { nodes.forEach(n=>{arr.push(n);allNodes(n.children||[],arr);}); return arr; }
function maxDepth(nodes,d=0) { if(!nodes.length) return d; return Math.max(...nodes.map(n=>maxDepth(n.children||[],d+1))); }

// ===== PLAN UI =====
function updatePlanUI() {
  const p = state.plan;
  const badge = document.getElementById('plan-badge-sidebar');
  if(p==='free'){badge.className='plan-badge plan-free';badge.textContent='Free';}
  else if(p==='plus'){badge.className='plan-badge plan-plus';badge.textContent='Plus';}
  else{badge.className='plan-badge plan-pro';badge.textContent='Pro';}

  // Export lock
  const elock=document.getElementById('export-lock');
  if(elock) elock.style.display = can('export')?'none':'flex';
  // Search lock
  const slock=document.getElementById('search-lock');
  if(slock) slock.style.display = can('nodeSearch')?'none':'flex';
  // Upgrade button
  const ubtn=document.getElementById('btn-upgrade');
  if(ubtn) ubtn.style.display = p==='pro'?'none':'flex';
  // Upgrade prompt
  const up=document.getElementById('upgrade-prompt');
  if(up) up.style.display = p==='pro'?'none':'block';
  // Stats bar
  document.getElementById('stats-bar').style.display = can('stats')&&getActiveTree()?'flex':'none';
  if(can('stats')&&getActiveTree()) renderStatsBar();
}

// ===== STATS BAR =====
function renderStatsBar() {
  const tree=getActiveTree(); if(!tree) return;
  const nodes=allNodes(tree.roots||[]);
  const withMedia=nodes.filter(n=>(n.media||[]).length).length;
  const depth=maxDepth(tree.roots||[]);
  document.getElementById('stats-bar').innerHTML=`
    <span class="stat-item"><i class="ti ti-git-branch"></i> <span class="stat-val">${nodes.length}</span> nodes</span>
    <span class="stat-item"><i class="ti ti-photo"></i> <span class="stat-val">${withMedia}</span> with media</span>
    <span class="stat-item"><i class="ti ti-layers-intersect"></i> Depth: <span class="stat-val">${depth}</span></span>
    <span class="stat-item"><i class="ti ti-trees"></i> Roots: <span class="stat-val">${(tree.roots||[]).length}</span></span>`;
}

// ===== PAYWALL =====
function openPaywall(highlight='plus', reason='') {
  if(reason){
    document.getElementById('pw-headline').textContent = reason;
    document.getElementById('pw-subhead').textContent = 'Upgrade to unlock this and many more features.';
  } else {
    document.getElementById('pw-headline').textContent = 'Unlock more with ResearchTree';
    document.getElementById('pw-subhead').textContent = 'Choose the plan that fits your research workflow.';
  }
  document.getElementById('paywall-overlay').classList.add('open');
}
function closePaywall() { document.getElementById('paywall-overlay').classList.remove('open'); }
function activatePlan(p) {
  state.plan = p;
  save(); closePaywall(); updatePlanUI(); renderSidebar(); renderCanvas(); updateDetailPanel();
  toast(p==='plus' ? '✓ Welcome to Plus!' : '✓ Welcome to Pro! All features unlocked.');
}

// ===== FEATURE GUARDS =====
function requirePlan(feature, reason) {
  if(can(feature)) return true;
  const needed = PLANS.plus[feature] ? 'plus' : 'pro';
  openPaywall(needed, reason);
  return false;
}

// ===== SIDEBAR =====
function filterTrees(q) { renderSidebar(q); }
function renderSidebar(filter='') {
  const list=document.getElementById('trees-list');
  const trees=state.trees.filter(t=>!filter||t.name.toLowerCase().includes(filter.toLowerCase()));
  if(!trees.length){
    list.innerHTML=`<div style="padding:20px;text-align:center;color:var(--text3);font-size:13px;line-height:1.7">${filter?'No matching trees.':'No trees yet.<br>Create your first research tree.'}</div>`;
    return;
  }
  list.innerHTML='';
  trees.forEach(tree=>{
    const div=document.createElement('div');
    div.className='tree-item'+(state.activeTree===tree.id?' active':'');
    div.innerHTML=`<div class="tree-icon" style="background:${tree.color}22">${tree.emoji}</div>
      <span class="tree-name">${escHtml(tree.name)}</span>
      <span class="tree-count">${countNodes(tree.roots||[])}n</span>
      <button class="tree-del-btn" onclick="deleteTree('${tree.id}',event)"><i class="ti ti-trash"></i></button>`;
    div.onclick=()=>activateTree(tree.id);
    list.appendChild(div);
  });
  // Show free limit warning
  if(state.plan==='free' && state.trees.length>=PLANS.free.trees){
    const warn=document.createElement('div');
    warn.style.cssText='margin:8px 12px;padding:8px 12px;background:#1e1a3a;border:1px solid #3d3870;border-radius:8px;font-size:12px;color:var(--text2);line-height:1.5;cursor:pointer';
    warn.innerHTML=`<i class="ti ti-lock" style="color:var(--accent)"></i> Free plan: ${PLANS.free.trees} trees max. <span style="color:var(--accent);font-weight:500">Upgrade →</span>`;
    warn.onclick=()=>openPaywall('plus','You\'ve reached the free tree limit');
    list.appendChild(warn);
  }
}
function toggleSidebar() { state.sidebarOpen=!state.sidebarOpen; document.getElementById('sidebar').classList.toggle('collapsed',!state.sidebarOpen); save(); }

// ===== TREE OPS =====
function handleNewTree() {
  if(state.plan==='free' && state.trees.length>=PLANS.free.trees){
    openPaywall('plus',`Free plan is limited to ${PLANS.free.trees} trees`); return;
  }
  openNewTreeModal();
}
function activateTree(id) { state.activeTree=id; state.selectedNode=null; save(); renderSidebar(); renderCanvas(); updateDetailPanel(); updatePlanUI(); }
function deleteTree(id,e) {
  e.stopPropagation();
  const tree=state.trees.find(t=>t.id===id);
  if(!confirm(`Delete "${tree.name}" and all its nodes?`)) return;
  state.trees=state.trees.filter(t=>t.id!==id);
  if(state.activeTree===id){state.activeTree=state.trees[0]?.id||null;state.selectedNode=null;}
  save(); renderSidebar(); renderCanvas(); updateDetailPanel(); toast('Tree deleted');
}

// ===== BREADCRUMB =====
function buildBreadcrumb(items) {
  const bc=document.getElementById('breadcrumb'); bc.innerHTML='';
  items.forEach((item,i)=>{
    if(i>0){const sep=document.createElement('span');sep.className='bc-sep';sep.textContent='›';bc.appendChild(sep);}
    const el=document.createElement('span');
    el.className='breadcrumb-item'+(i===items.length-1?' current':'');
    el.textContent=item.label;
    if(item.onClick) el.onclick=item.onClick;
    bc.appendChild(el);
  });
}

// ===== RENDER CANVAS =====
function renderCanvas() {
  const canvas=document.getElementById('canvas');
  document.getElementById('btn-settings').style.display=getActiveTree()?'flex':'none';
  const tree=getActiveTree();
  if(!tree){
    canvas.innerHTML='';
    const es=document.createElement('div'); es.className='empty-state'; es.style.minHeight='60vh';
    es.innerHTML=`<div style="font-size:72px;color:var(--accent)"><i class="ti ti-trees"></i></div>
      <h2>Welcome to ResearchTree</h2>
      <p>Organize any topic into deep, expandable research trees with notes, images, videos, and links.</p>
      <button class="btn-primary" onclick="handleNewTree()"><i class="ti ti-plus"></i> Create your first tree</button>`;
    canvas.appendChild(es);
    buildBreadcrumb([{label:'Research Trees'}]);
    return;
  }
  buildBreadcrumb([{label:'Research Trees'},{label:tree.emoji+' '+tree.name}]);
  canvas.innerHTML='';
  (tree.roots||[]).forEach(node=>canvas.appendChild(buildNodeEl(node,true,tree)));
  // Node limit banner for free
  if(state.plan==='free' && totalNodes()>=PLANS.free.nodes){
    const banner=makeLimitBanner('You\'ve reached 20 nodes on the free plan','Upgrade to Plus for unlimited nodes and media attachments.','plus','Upgrade to Plus');
    canvas.appendChild(banner);
  } else {
    const addBtn=document.createElement('button');
    addBtn.className='add-root-btn';
    addBtn.innerHTML='<i class="ti ti-plus"></i> Add root node';
    addBtn.onclick=()=>handleAddNode({parentId:null,treeId:tree.id});
    canvas.appendChild(addBtn);
  }
  updatePlanUI();
}

function makeLimitBanner(title,desc,plan,btnLabel) {
  const div=document.createElement('div'); div.className='limit-banner';
  div.innerHTML=`<div class="lb-icon"><i class="ti ti-lock" style="color:var(--accent);font-size:20px"></i></div>
    <div class="lb-text"><div class="lb-title">${escHtml(title)}</div><div class="lb-desc">${escHtml(desc)}</div></div>
    <button class="lb-btn ${plan==='pro'?'btn-gold':'btn-teal'}" onclick="openPaywall('${plan}','${escHtml(title)}')">${escHtml(btnLabel)}</button>`;
  return div;
}

function buildNodeEl(node,isRoot,tree) {
  const collapsed=state.collapsed[node.id];
  const hasChildren=(node.children||[]).length>0;
  const isSelected=state.selectedNode===node.id;

  const wrap=document.createElement('div'); wrap.style.cssText='display:flex;flex-direction:column';
  const card=document.createElement('div');
  let cls='node-card'+(isRoot?' root-card':'')+(isSelected?' selected':'');
  if(can('nodeColors')&&node.color&&node.color!=='none') cls+=` color-${node.color}`;
  card.className=cls; card.dataset.id=node.id;

  const imgs=(node.media||[]).filter(m=>m.type==='image');
  const vids=(node.media||[]).filter(m=>m.type==='video');
  const links=(node.media||[]).filter(m=>m.type==='link');

  let thumbsHTML='';
  if(imgs.length && can('media')){
    thumbsHTML=`<div class="media-thumbs">${imgs.slice(0,4).map(m=>`<div class="media-thumb"><img src="${escHtml(m.url)}" alt="${escHtml(m.name||'')}" onerror="this.parentNode.innerHTML='🖼️'"></div>`).join('')}</div>`;
  }

  const tags=[
    imgs.length&&can('media')?`<span class="node-tag tag-img">🖼️ ${imgs.length}</span>`:'',
    vids.length&&can('media')?`<span class="node-tag tag-vid">🎬 ${vids.length}</span>`:'',
    links.length?`<span class="node-tag tag-link">🔗 ${links.length}</span>`:'',
    (node.tags||[]).map(t=>`<span class="node-tag" style="background:#1e2028;color:var(--text2);border:1px solid var(--border2)">#${escHtml(t)}</span>`).join('')
  ].filter(Boolean).join('');

  const hasDetail=node.desc||(node.media||[]).length;

  card.innerHTML=`
    <div class="node-header">
      <div style="flex:1;min-width:0">
        <div class="node-title">${escHtml(node.title)}</div>
        ${node.desc?`<div class="node-desc">${escHtml(node.desc.slice(0,130))}${node.desc.length>130?'…':''}</div>`:''}
      </div>
      ${hasChildren?`<button class="expand-btn" onclick="toggleCollapse('${node.id}',event)"><i class="ti ti-chevron-${collapsed?'right':'down'}"></i></button>`:''}
    </div>
    ${thumbsHTML}
    ${tags?`<div class="node-meta">${tags}</div>`:''}
    ${node.note&&can('nodeNotes')?`<div class="node-note">${escHtml(node.note.slice(0,200))}${(node.note||'').length>200?'…':''}</div>`:''}
    <div class="node-actions">
      <button class="node-btn btn-child" onclick="handleAddNode({parentId:'${node.id}',treeId:'${tree.id}'},event)"><i class="ti ti-plus"></i> Add child</button>
      <button class="node-btn btn-edit-node" onclick="openNodeModal({editId:'${node.id}',treeId:'${tree.id}'},event)"><i class="ti ti-pencil"></i> Edit</button>
      <button class="node-btn btn-del-node" onclick="confirmDeleteNode('${node.id}','${tree.id}',event)"><i class="ti ti-trash"></i></button>
      ${hasDetail?`<button class="node-btn btn-detail" onclick="selectNode('${node.id}','${tree.id}',event)"><i class="ti ti-info-circle"></i> Info</button>`:''}
    </div>`;
  card.onclick=(e)=>{if(e.target===card)selectNode(node.id,tree.id,e);};
  wrap.appendChild(card);

  if(hasChildren&&!collapsed){
    const cw=document.createElement('div'); cw.className='children-wrap';
    (node.children||[]).forEach(child=>cw.appendChild(buildNodeEl(child,false,tree)));
    const sib=document.createElement('button'); sib.className='add-sibling-btn';
    sib.innerHTML='<i class="ti ti-plus"></i> Add sibling';
    sib.onclick=(e)=>{e.stopPropagation();handleAddNode({siblingOf:node.id,treeId:tree.id},e);};
    cw.appendChild(sib); wrap.appendChild(cw);
  }
  return wrap;
}

function handleAddNode(opts,e) {
  if(e) e.stopPropagation();
  if(state.plan==='free' && totalNodes()>=PLANS.free.nodes){
    openPaywall('plus',`Free plan is limited to ${PLANS.free.nodes} nodes`); return;
  }
  openNodeModal(opts,e);
}

// ===== COLLAPSE =====
function toggleCollapse(id,e) { e.stopPropagation(); state.collapsed[id]=!state.collapsed[id]; save(); renderCanvas(); }
function expandAll() { state.collapsed={}; save(); renderCanvas(); toast('All nodes expanded'); }
function collapseAll() {
  const tree=getActiveTree(); if(!tree) return;
  function col(nodes){nodes.forEach(n=>{state.collapsed[n.id]=true;col(n.children||[]);});}
  col(tree.roots||[]); save(); renderCanvas(); toast('All nodes collapsed');
}

// ===== NODE SEARCH =====
function handleNodeSearch() {
  if(!requirePlan('nodeSearch','Node search is a Plus feature')) return;
  const bar=document.getElementById('node-search-bar');
  bar.style.display=bar.style.display==='none'?'block':'none';
  if(bar.style.display==='block') document.getElementById('node-search-input').focus();
  else { renderCanvas(); }
}
function searchNodes(q) {
  if(!q.trim()){renderCanvas();return;}
  const tree=getActiveTree(); if(!tree) return;
  const canvas=document.getElementById('canvas'); canvas.innerHTML='';
  const nodes=allNodes(tree.roots||[]).filter(n=>n.title.toLowerCase().includes(q.toLowerCase())||(n.desc||'').toLowerCase().includes(q.toLowerCase()));
  if(!nodes.length){canvas.innerHTML=`<div style="padding:40px;text-align:center;color:var(--text3);font-size:14px">No matching nodes found.</div>`;return;}
  nodes.forEach(node=>{
    const card=document.createElement('div'); card.className='node-card'; card.style.marginBottom='8px';
    card.innerHTML=`<div class="node-title">${escHtml(node.title)}</div>${node.desc?`<div class="node-desc">${escHtml(node.desc.slice(0,200))}</div>`:''}`;
    card.onclick=()=>{document.getElementById('node-search-input').value='';searchNodes('');selectNode(node.id,tree.id,null);};
    canvas.appendChild(card);
  });
}

