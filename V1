function addMediaItem(){
  const url=document.getElementById('m-url').value.trim(); if(!url){toast('Enter a URL');return;}
  const type=document.getElementById('m-type').value;
  const name=document.getElementById('m-name').value.trim();
  _mediaItems.push({url,type,name:name||url.split('/').pop().split('?')[0]||url});
  document.getElementById('m-url').value=''; document.getElementById('m-name').value='';
  renderMediaList(); toast('Media added');
}
function removeMediaItem(i){_mediaItems.splice(i,1);renderMediaList();}

function saveNode(optsStr){
  const opts=JSON.parse(optsStr);
  const title=document.getElementById('n-title').value.trim(); if(!title){toast('Please enter a title');return;}
  const desc=document.getElementById('n-desc').value.trim();
  const note=can('nodeNotes')&&document.getElementById('n-note')?document.getElementById('n-note').value.trim():'';
  const tags=can('nodeTags')&&document.getElementById('n-tags')?document.getElementById('n-tags').value.split(',').map(t=>t.trim()).filter(Boolean):[];
  const media=[..._mediaItems];
  const color=_selectedNodeColor||'none';
  const tree=state.trees.find(t=>t.id===opts.treeId);

  if(opts.editId){
    const node=findNode(tree.roots||[],opts.editId);
    if(node){node.title=title;node.desc=desc;node.media=media;if(can('nodeNotes'))node.note=note;if(can('nodeTags'))node.tags=tags;if(can('nodeColors'))node.color=color;}
    toast('✓ Node updated');
  } else {
    const newNode={id:uid(),title,desc,media,note,tags,color,children:[],created:Date.now()};
    if(opts.parentId){
      const parent=findNode(tree.roots||[],opts.parentId);
      if(parent){parent.children=parent.children||[];parent.children.push(newNode);state.collapsed[opts.parentId]=false;}
    } else if(opts.siblingOf){
      function addSib(nodes){for(let i=0;i<nodes.length;i++){if(nodes[i].id===opts.siblingOf){nodes.push(newNode);return true;}if(addSib(nodes[i].children||[]))return true;}return false;}
      addSib(tree.roots);
    } else {
      tree.roots=tree.roots||[];tree.roots.push(newNode);
    }
    toast('✓ Node added');
  }
  save();closeModal();renderSidebar();renderCanvas();
  if(state.selectedNode===opts.editId)updateDetailPanel();
}

function confirmDeleteNode(nodeId,treeId,e){
  e.stopPropagation();
  const tree=state.trees.find(t=>t.id===treeId);
  const node=findNode(tree.roots||[],nodeId);
  const cc=countNodes(node.children||[]);
  if(!confirm(cc>0?`Delete "${node.title}" and its ${cc} child${cc>1?'ren':''}?`:`Delete "${node.title}"?`)) return;
  deleteNodeFrom(tree.roots||[],nodeId);
  if(state.selectedNode===nodeId){state.selectedNode=null;updateDetailPanel();}
  save();renderSidebar();renderCanvas();toast('Node deleted');
}

