<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ResearchTree</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0d0e12;--surface:#16181f;--surface2:#1e2028;--surface3:#252832;
  --border:#2e3140;--border2:#3a3e52;--text:#e8eaf2;--text2:#9099b5;--text3:#5a6280;
  --accent:#7c6af0;--accent2:#5e4fd4;--gold:#d4a843;--gold2:#b8892e;
  --teal:#3dbfa0;--coral:#e8715a;--plus:#3dbfa0;--pro:#d4a843;
  --radius:10px;--radius-lg:16px;
}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden}

/* LAYOUT */
#app{display:flex;height:100vh;overflow:hidden}
#sidebar{width:300px;min-width:300px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;transition:width .3s,min-width .3s}
#sidebar.collapsed{width:0;min-width:0}
#main{flex:1;display:flex;flex-direction:column;overflow:hidden}

/* SIDEBAR */
.sidebar-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;white-space:nowrap;overflow:hidden}
.logo{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;letter-spacing:-0.5px}
.logo span{color:var(--accent)}
.plan-badge{font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px;letter-spacing:.4px;text-transform:uppercase;flex-shrink:0}
.plan-free{background:#1e2028;color:var(--text3);border:1px solid var(--border2)}
.plan-plus{background:#0d2420;color:var(--plus);border:1px solid #1a4038}
.plan-pro{background:#2a1e08;color:var(--pro);border:1px solid #4a3210}
.search-wrap{padding:10px 12px;border-bottom:1px solid var(--border);position:relative}
.search-icon{position:absolute;left:20px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:14px;pointer-events:none}
.search-input{width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;padding:8px 12px 8px 32px;outline:none;transition:.15s}
.search-input:focus{border-color:var(--accent)}
.sidebar-section-label{font-size:10px;font-weight:500;color:var(--text3);text-transform:uppercase;letter-spacing:.8px;padding:8px 12px 4px}
.trees-list{flex:1;overflow-y:auto;padding:12px}
.tree-item{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:var(--radius);cursor:pointer;transition:.15s;margin-bottom:4px;border:1px solid transparent;white-space:nowrap;overflow:hidden}
.tree-item:hover{background:var(--surface2)}
.tree-item.active{background:var(--surface3);border-color:var(--border2)}
.tree-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.tree-name{font-size:14px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}
.tree-count{font-size:11px;color:var(--text3);flex-shrink:0}
.tree-del-btn{width:22px;height:22px;background:transparent;border:none;color:var(--text3);cursor:pointer;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:12px;transition:.15s}
.tree-del-btn:hover{color:var(--coral);background:#2e1e20}
.btn-new-tree{margin:12px;padding:10px 16px;background:var(--accent);color:#fff;border:none;border-radius:var(--radius);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;display:flex;align-items:center;gap:8px;transition:.15s}
.btn-new-tree:hover{background:var(--accent2)}
.sidebar-upgrade{margin:0 12px 12px;padding:12px;background:linear-gradient(135deg,#1e1a3a,#1a2838);border:1px solid #3d3870;border-radius:var(--radius);cursor:pointer;transition:.15s}
.sidebar-upgrade:hover{border-color:var(--accent)}
.su-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:4px}
.su-title{font-size:13px;font-weight:500;color:var(--text);margin-bottom:6px}
.su-btn{font-size:12px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:4px}

/* TOPBAR */
#topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 20px;height:56px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.breadcrumb{display:flex;align-items:center;gap:6px;flex:1;overflow:hidden}
.breadcrumb-item{font-size:13px;color:var(--text2);cursor:pointer;white-space:nowrap;transition:.15s}
.breadcrumb-item:hover{color:var(--text)}
.breadcrumb-item.current{color:var(--text);font-weight:500}
.bc-sep{color:var(--text3);font-size:12px}
.topbar-actions{display:flex;gap:6px;flex-shrink:0}
.icon-btn{width:34px;height:34px;border:1px solid var(--border2);border-radius:8px;background:transparent;color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:.15s;position:relative}
.icon-btn:hover{background:var(--surface2);color:var(--text)}
.icon-btn.active{background:rgba(124,106,240,.15);border-color:var(--accent);color:var(--accent)}
.icon-btn .lock-dot{position:absolute;top:-3px;right:-3px;width:10px;height:10px;border-radius:50%;background:var(--gold);border:2px solid var(--bg);font-size:6px;display:flex;align-items:center;justify-content:center}

/* CANVAS */
#canvas-wrap{flex:1;overflow:auto;padding:36px 40px}
#canvas{display:flex;flex-direction:column;align-items:flex-start;gap:0;min-width:600px}

/* EMPTY STATE */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:16px;text-align:center;width:100%}
.empty-state h2{font-family:'Playfair Display',serif;font-size:28px}
.empty-state p{color:var(--text2);font-size:15px;max-width:340px;line-height:1.7}

/* NODE CARDS */
.node-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;min-width:260px;max-width:380px;margin:8px 0;cursor:default;transition:.2s;position:relative}
.node-card:hover{border-color:var(--border2);background:var(--surface2)}
.node-card.root-card{background:linear-gradient(135deg,#1e1a3a 0%,#1a2235 100%);border-color:#3d3870;min-width:320px}
.node-card.selected{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,106,240,.15)}
.node-header{display:flex;align-items:flex-start;gap:8px;margin-bottom:6px}
.node-title{font-family:'Playfair Display',serif;font-size:15px;font-weight:600;line-height:1.35;flex:1}
.node-card.root-card .node-title{font-size:19px}
.node-desc{font-size:12px;color:var(--text2);line-height:1.6;margin-bottom:10px}
.node-meta{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-bottom:8px}
.node-tag{font-size:10px;padding:2px 8px;border-radius:20px;font-weight:500}
.tag-img{background:#1a2e28;color:var(--teal);border:1px solid #264038}
.tag-vid{background:#1e1a3a;color:#9a8df8;border:1px solid #3d3870}
.tag-link{background:#2e1e20;color:var(--coral);border:1px solid #3e2828}
.node-actions{display:flex;gap:4px;flex-wrap:wrap}
.node-btn{padding:5px 10px;border-radius:6px;font-size:11px;font-weight:500;cursor:pointer;border:1px solid;transition:.15s;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:4px;white-space:nowrap}
.btn-child{background:transparent;border-color:var(--accent);color:var(--accent)}
.btn-child:hover{background:var(--accent);color:#fff}
.btn-edit-node{background:transparent;border-color:var(--border2);color:var(--text2)}
.btn-edit-node:hover{background:var(--surface3);color:var(--text)}
.btn-del-node{background:transparent;border-color:#3e2828;color:var(--coral)}
.btn-del-node:hover{background:#2e1e20}
.btn-detail{background:transparent;border-color:var(--border2);color:var(--text2);margin-left:auto}
.btn-detail:hover{background:var(--surface3);color:var(--text)}
.expand-btn{width:22px;height:22px;border-radius:5px;background:var(--surface3);border:1px solid var(--border2);color:var(--text2);display:flex;align-items:center;justify-content:center;font-size:12px;cursor:pointer;flex-shrink:0;transition:.15s}
.expand-btn:hover{background:var(--border2);color:var(--text)}
.media-thumbs{display:flex;gap:4px;flex-wrap:wrap;margin:6px 0}
.media-thumb{width:52px;height:38px;border-radius:6px;background:var(--surface3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:18px;overflow:hidden;flex-shrink:0}
.media-thumb img{width:100%;height:100%;object-fit:cover}
.node-color-bar{position:absolute;left:0;top:12px;bottom:12px;width:3px;border-radius:0 3px 3px 0}

/* TREE STRUCTURE */
.children-wrap{padding-left:28px;border-left:1px solid var(--border2);margin-left:22px;display:flex;flex-direction:column}
.add-sibling-btn{margin:6px 0 14px;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:500;cursor:pointer;border:1px dashed var(--border2);color:var(--text3);background:transparent;display:inline-flex;align-items:center;gap:4px;font-family:'DM Sans',sans-serif;transition:.15s;width:fit-content}
.add-sibling-btn:hover{border-color:var(--accent);color:var(--accent)}
.add-root-btn{margin-top:16px;padding:9px 18px;border-radius:9px;font-size:13px;font-weight:500;cursor:pointer;border:1px dashed var(--accent);color:var(--accent);background:transparent;display:inline-flex;align-items:center;gap:6px;font-family:'DM Sans',sans-serif;transition:.15s}
.add-root-btn:hover{background:rgba(124,106,240,.1)}

/* DETAIL PANEL */
#detail-panel{width:380px;min-width:380px;background:var(--surface);border-left:1px solid var(--border);overflow-y:auto;transition:width .3s,min-width .3s;flex-shrink:0}
#detail-panel.hidden{width:0;min-width:0;overflow:hidden}
.detail-inner{padding:24px}
.detail-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;margin-bottom:10px;line-height:1.3}
.detail-desc{font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:20px;white-space:pre-wrap}
.detail-section{margin-bottom:20px}
.detail-section-title{font-size:11px;font-weight:500;color:var(--text3);text-transform:uppercase;letter-spacing:.8px;margin-bottom:10px;display:flex;align-items:center;gap:6px;padding-bottom:6px;border-bottom:1px solid var(--border)}
.detail-media-item{border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);margin-bottom:8px;background:var(--surface2)}
.detail-media-img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.detail-media-caption{font-size:12px;color:var(--text2);padding:8px 10px}
.detail-video-wrap{aspect-ratio:16/9;background:var(--surface3)}
.detail-video-wrap iframe{width:100%;height:100%;border:none;display:block}
.detail-link{display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--border);border-radius:9px;text-decoration:none;color:var(--text2);font-size:13px;margin-bottom:6px;transition:.15s;background:var(--surface2)}
.detail-link:hover{border-color:var(--border2);color:var(--text);background:var(--surface3)}
.detail-close{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.detail-path{font-size:11px;color:var(--text3)}
/* Node note card (Pro) */
.node-note{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 14px;margin-top:8px;font-size:13px;color:var(--text2);line-height:1.6;white-space:pre-wrap}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--border2);border-radius:var(--radius-lg);width:100%;max-width:580px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.modal-header{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--surface);z-index:1}
.modal-title{font-family:'Playfair Display',serif;font-size:18px;font-weight:600}
.modal-body{padding:20px 24px}
.modal-footer{padding:16px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;position:sticky;bottom:0;background:var(--surface)}
.field{margin-bottom:18px}
.field label{display:block;font-size:11px;font-weight:500;color:var(--text2);margin-bottom:7px;text-transform:uppercase;letter-spacing:.6px}
.field input,.field textarea,.field select{width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;padding:10px 13px;transition:.15s;outline:none;-webkit-appearance:none}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,106,240,.15)}
.field textarea{min-height:90px;resize:vertical;line-height:1.6}
.field select option{background:var(--surface2)}
.btn-primary{padding:10px 22px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;gap:6px}
.btn-primary:hover{background:var(--accent2)}
.btn-secondary{padding:10px 22px;background:transparent;color:var(--text2);border:1px solid var(--border2);border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;cursor:pointer;transition:.15s}
.btn-secondary:hover{background:var(--surface2);color:var(--text)}
.btn-danger{padding:10px 22px;background:transparent;color:var(--coral);border:1px solid #3e2828;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;cursor:pointer;transition:.15s}
.btn-danger:hover{background:#2e1e20}
.btn-gold{padding:10px 22px;background:linear-gradient(135deg,#d4a843,#b8892e);color:#1a1200;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;gap:6px}
.btn-gold:hover{opacity:.9}
.btn-teal{padding:10px 22px;background:linear-gradient(135deg,#3dbfa0,#2a9b82);color:#001a14;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;gap:6px}
.btn-teal:hover{opacity:.9}
.emoji-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.emoji-opt{width:38px;height:38px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:19px;transition:.15s}
.emoji-opt:hover{border-color:var(--border2)}
.emoji-opt.selected{border-color:var(--accent);background:rgba(124,106,240,.12)}
.color-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.color-opt{width:28px;height:28px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:.15s}
.color-opt:hover{transform:scale(1.15)}
.color-opt.selected{border-color:var(--text);transform:scale(1.1)}

/* MEDIA LIST */
.media-list{display:flex;flex-direction:column;gap:6px;margin-bottom:10px}
.media-item-row{display:flex;align-items:center;gap:8px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px 12px}
.mi-icon{width:30px;height:30px;border-radius:6px;background:var(--surface3);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.mi-info{flex:1;min-width:0}
.mi-name{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mi-url{font-size:11px;color:var(--text3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mi-del{width:28px;height:28px;border:none;background:transparent;color:var(--text3);cursor:pointer;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;transition:.15s;flex-shrink:0}
.mi-del:hover{color:var(--coral);background:#2e1e20}

/* PAYWALL MODAL */
.paywall-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:2000;display:none;align-items:center;justify-content:center;padding:20px}
.paywall-overlay.open{display:flex}
.paywall-modal{background:var(--surface);border:1px solid var(--border2);border-radius:20px;width:100%;max-width:640px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.6)}
.paywall-header{padding:32px 32px 24px;text-align:center;background:linear-gradient(135deg,#14102e 0%,#0d1a2e 100%);border-bottom:1px solid var(--border)}
.paywall-header h2{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;margin-bottom:8px}
.paywall-header p{color:var(--text2);font-size:14px;line-height:1.6;max-width:380px;margin:0 auto}
.paywall-plans{display:grid;grid-template-columns:1fr 1fr;gap:0;padding:0}
.plan-col{padding:28px 28px 24px;border-right:1px solid var(--border)}
.plan-col:last-child{border-right:none}
.plan-col.highlighted{background:linear-gradient(135deg,#1a1408 0%,#12100a 100%)}
.plan-name{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
.plan-price{font-family:'Playfair Display',serif;font-size:32px;font-weight:700;margin-bottom:4px;line-height:1}
.plan-price span{font-size:14px;font-weight:400;color:var(--text2);font-family:'DM Sans',sans-serif}
.plan-tagline{font-size:12px;color:var(--text2);margin-bottom:18px;line-height:1.5}
.plan-features{list-style:none;margin-bottom:20px;display:flex;flex-direction:column;gap:8px}
.plan-features li{font-size:13px;color:var(--text2);display:flex;align-items:flex-start;gap:8px;line-height:1.4}
.plan-features li i{font-size:14px;margin-top:1px;flex-shrink:0}
.feat-check{color:var(--teal)}
.feat-gold{color:var(--gold)}
.paywall-footer{padding:16px 28px;border-top:1px solid var(--border);display:flex;justify-content:center}

/* LIMIT BANNER */
.limit-banner{background:linear-gradient(135deg,#1e1a3a,#1a2035);border:1px solid #3d3870;border-radius:12px;padding:16px 20px;margin:20px 0;display:flex;align-items:center;gap:14px}
.lb-icon{width:40px;height:40px;border-radius:10px;background:rgba(124,106,240,.15);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.lb-text{flex:1}
.lb-title{font-size:14px;font-weight:500;margin-bottom:3px}
.lb-desc{font-size:12px;color:var(--text2);line-height:1.5}
.lb-btn{padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;white-space:nowrap;font-family:'DM Sans',sans-serif;transition:.15s}

/* FEATURE LOCKED BADGE */
.feat-locked{display:inline-flex;align-items:center;gap:4px;font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600;cursor:pointer;transition:.15s}
.locked-plus{background:#0d2420;color:var(--plus);border:1px solid #1a4038}
.locked-plus:hover{background:#1a4038}
.locked-pro{background:#2a1e08;color:var(--pro);border:1px solid #4a3210}
.locked-pro:hover{background:#4a3210}

/* PRO NODE COLORS */
.node-card.color-teal{border-left:3px solid var(--teal)}
.node-card.color-coral{border-left:3px solid var(--coral)}
.node-card.color-gold{border-left:3px solid var(--gold)}
.node-card.color-purple{border-left:3px solid var(--accent)}
.node-card.color-blue{border-left:3px solid #5bc8f5}

/* STATS BAR (Pro) */
.stats-bar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 24px;height:36px;display:flex;align-items:center;gap:20px;font-size:12px;color:var(--text3);flex-shrink:0}
.stat-item{display:flex;align-items:center;gap:5px}
.stat-val{color:var(--text2);font-weight:500}

/* EXPORT MENU */
.export-menu{position:absolute;top:38px;right:0;background:var(--surface);border:1px solid var(--border2);border-radius:10px;padding:6px;min-width:160px;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.4)}
.export-item{padding:8px 12px;border-radius:7px;font-size:13px;cursor:pointer;display:flex;align-items:center;gap:8px;color:var(--text2);transition:.15s}
.export-item:hover{background:var(--surface2);color:var(--text)}

/* TOAST */
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--surface2);border:1px solid var(--border2);border-radius:10px;padding:10px 18px;font-size:13px;color:var(--text);opacity:0;transition:opacity .3s;pointer-events:none;z-index:3000;white-space:nowrap;box-shadow:0 8px 24px rgba(0,0,0,.4)}
#toast.show{opacity:1}

::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:10px}
::-webkit-scrollbar-thumb:hover{background:var(--text3)}
</style>
</head>
<body>
<div id="app">
  <!-- SIDEBAR -->
  <div id="sidebar">
    <div class="sidebar-header">
      <i class="ti ti-tree" style="font-size:22px;color:var(--accent);flex-shrink:0"></i>
      <span class="logo">Research<span>Tree</span></span>
      <span class="plan-badge plan-free" id="plan-badge-sidebar">Free</span>
    </div>
    <div class="search-wrap">
      <i class="ti ti-search search-icon"></i>
      <input class="search-input" id="search-input" placeholder="Search trees..." oninput="filterTrees(this.value)">
    </div>
    <div class="sidebar-section-label">Your Trees</div>
    <div class="trees-list" id="trees-list"></div>
    <button class="btn-new-tree" onclick="handleNewTree()"><i class="ti ti-plus"></i> New Research Tree</button>
    <div class="sidebar-upgrade" id="upgrade-prompt" onclick="openPaywall('plus')">
      <div class="su-label">Upgrade</div>
      <div class="su-title">Unlock unlimited trees, exports & more</div>
      <div class="su-btn"><i class="ti ti-arrow-up-circle"></i> View plans →</div>
    </div>
  </div>

  <!-- MAIN -->
  <div id="main">
    <div id="topbar">
      <button class="icon-btn" onclick="toggleSidebar()" title="Toggle sidebar"><i class="ti ti-layout-sidebar"></i></button>
      <div class="breadcrumb" id="breadcrumb"></div>
      <div class="topbar-actions">
        <button class="icon-btn" onclick="expandAll()" title="Expand all"><i class="ti ti-arrows-maximize"></i></button>
        <button class="icon-btn" onclick="collapseAll()" title="Collapse all"><i class="ti ti-arrows-minimize"></i></button>
        <button class="icon-btn" id="btn-detail" onclick="toggleDetailPanel()" title="Info panel"><i class="ti ti-layout-sidebar-right"></i></button>
        <button class="icon-btn" id="btn-search-nodes" onclick="handleNodeSearch()" title="Search nodes">
          <i class="ti ti-search"></i>
          <span class="lock-dot" id="search-lock" title="Plus feature">+</span>
        </button>
        <div style="position:relative">
          <button class="icon-btn" id="btn-export" onclick="handleExport()" title="Export tree">
            <i class="ti ti-download"></i>
            <span class="lock-dot" id="export-lock" title="Plus feature">+</span>
          </button>
          <div class="export-menu" id="export-menu" style="display:none">
            <div class="export-item" onclick="exportJSON()"><i class="ti ti-file-code"></i> Export JSON</div>
            <div class="export-item" onclick="exportMarkdown()"><i class="ti ti-markdown"></i> Export Markdown</div>
            <div class="export-item" onclick="exportCSV()"><i class="ti ti-table"></i> Export CSV</div>
            <div class="export-item" onclick="printTree()"><i class="ti ti-printer"></i> Print / PDF</div>
          </div>
        </div>
        <button class="icon-btn" onclick="openTreeSettingsModal()" id="btn-settings" title="Tree settings"><i class="ti ti-settings"></i></button>
        <button class="icon-btn" onclick="openPaywall('plus')" title="Upgrade plan" id="btn-upgrade" style="border-color:#3d3870;color:var(--accent)"><i class="ti ti-crown"></i></button>
      </div>
    </div>
    <div id="stats-bar" class="stats-bar" style="display:none"></div>
    <div id="node-search-bar" style="display:none;background:var(--surface);border-bottom:1px solid var(--border);padding:10px 20px">
      <input id="node-search-input" style="width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;padding:9px 14px;outline:none" placeholder="Search nodes in this tree..." oninput="searchNodes(this.value)">
    </div>
    <div id="canvas-wrap"><div id="canvas"></div></div>
  </div>

  <!-- DETAIL PANEL -->
  <div id="detail-panel" class="hidden">
    <div class="detail-inner" id="detail-inner">
      <div class="empty-state" style="min-height:300px">
        <div style="font-size:40px;color:var(--text3)"><i class="ti ti-info-circle"></i></div>
        <p>Click a node's Info button to see details here.</p>
      </div>
    </div>
  </div>
</div>

<!-- MAIN MODAL -->
<div class="modal-overlay" id="modal-overlay" onclick="handleOverlayClick(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-header">
      <span class="modal-title" id="modal-title"></span>
      <button class="icon-btn" onclick="closeModal()"><i class="ti ti-x"></i></button>
    </div>
    <div class="modal-body" id="modal-body"></div>
    <div class="modal-footer" id="modal-footer"></div>
  </div>
</div>

<!-- PAYWALL MODAL -->
<div class="paywall-overlay" id="paywall-overlay" onclick="if(event.target===this)closePaywall()">
  <div class="paywall-modal">
    <div class="paywall-header">
      <h2 id="pw-headline">Unlock more with ResearchTree</h2>
      <p id="pw-subhead">Choose the plan that fits your research workflow.</p>
    </div>
    <div class="paywall-plans">
      <div class="plan-col">
        <div class="plan-name" style="color:var(--plus)">Plus</div>
        <div class="plan-price" style="color:var(--text)">$9<span>/mo</span></div>
        <div class="plan-tagline">For serious researchers who need more room to think.</div>
        <ul class="plan-features">
          <li><i class="ti ti-check feat-check"></i>Unlimited research trees</li>
          <li><i class="ti ti-check feat-check"></i>Unlimited nodes per tree</li>
          <li><i class="ti ti-check feat-check"></i>Full-text node search</li>
          <li><i class="ti ti-check feat-check"></i>Export to JSON, Markdown & CSV</li>
          <li><i class="ti ti-check feat-check"></i>Print / PDF export</li>
          <li><i class="ti ti-check feat-check"></i>Node images & video embeds</li>
          <li><i class="ti ti-check feat-check"></i>Tree import from JSON</li>
